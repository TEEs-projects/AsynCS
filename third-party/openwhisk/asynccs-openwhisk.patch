diff --git a/tests/src/test/scala/org/apache/openwhisk/core/scheduler/queue/test/TargetBoundActivationDispatcherTests.scala b/tests/src/test/scala/org/apache/openwhisk/core/scheduler/queue/test/TargetBoundActivationDispatcherTests.scala
